# Copy to .env. Nothing in .env is committed. Missing values are generated on first start and written to .env.

# Secret shared by the verifier instances for their /internal/sync calls.
INTERNAL_SYNC_KEY=change-me-to-a-long-random-value

# Passwords of the demo accounts (at least 8 characters). Used only when the accounts are first created;
# after changing them, run "npm run reset".
#   institutions: astra@demo.true, ironworks@demo.true, nimbus@demo.true
#   people:       aarav@demo.true, isha@demo.true, kabir@demo.true
DEMO_PASSWORD_INSTITUTIONS=change-me-institutions
DEMO_PASSWORD_PEOPLE=change-me-people

# Rate limiting in the verifier front door (these are the defaults)
RATE_FAIL_MAX=5
RATE_FAIL_WINDOW_SECONDS=60
RATE_BLOCK_SECONDS=60
RATE_CREATE_MAX_PER_MINUTE=120
# Number of verifier instances behind the front door
VERIFIER_INSTANCES=3

# How many days a register's visitor list keeps a visit
VISIT_RETENTION_DAYS=30

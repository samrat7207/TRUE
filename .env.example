INTERNAL_SYNC_KEY=change-me-to-a-long-random-value

# Rate limiting in the verifier front door (these are the defaults)
RATE_FAIL_MAX=5
RATE_FAIL_WINDOW_SECONDS=60
RATE_BLOCK_SECONDS=60
RATE_CREATE_MAX_PER_MINUTE=120
# Number of verifier instances behind the front door
VERIFIER_INSTANCES=3

# Demo staff PINs for the issuer console (4 to 8 digits). Used only when the staff table is first created.
# After changing them, run "npm run reset" so the staff are created again.
STAFF_PIN_ADMIN=000000
STAFF_PIN_ISSUER=000000
STAFF_PIN_REVOKER=000000
STAFF_PIN_AUDITOR=000000
